# TMDB API anahtarı (film verileri için zorunlu).
TMDB_API_KEY=

# Google ile giriş (opsiyonel). Boş bırakılırsa Google butonu görünmez.
# Google Cloud Console > API'ler ve Hizmetler > Kimlik Bilgileri'nden alınır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flask oturum imzalama anahtarı (opsiyonel; boşsa .cache/flask-session-secret
# içinde otomatik üretilip saklanır).
FLASK_SECRET_KEY=
